{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "paths": {
      "@playwright/test": ["./frontend/node_modules/@playwright/test"]
    },
    "typeRoots": [
      "./frontend/node_modules/@types"
    ],
    "types": [
      "node"
    ]
  },
  "include": [
    "playwright.config.ts",
    "tests/**/*.ts"
  ]
}
